# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1

# Database Configuration
MONGO_URI=mongodb://localhost:27017/ai_fashion_otd

# JWT Security (Must be high-entropy 64+ char random keys in production)
JWT_ACCESS_SECRET=your_production_jwt_access_secret_entropy_64_chars_min
JWT_REFRESH_SECRET=your_production_jwt_refresh_secret_entropy_64_chars_min
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS Allowed Origins (Comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Foundation Model AI Providers (Gemini / OpenAI / Rules)
# AI_PROVIDER default is 'auto': uses Gemini when GEMINI_API_KEYS is provided, otherwise graceful rules fallback.
AI_PROVIDER=auto
GEMINI_API_KEYS=your_primary_gemini_api_key_here,your_backup_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
GEMINI_VISION_MODEL=gemini-3.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_IMAGE_MODEL_PRO=gemini-3-pro-image-preview
OPENAI_API_KEY=
