# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1

# Database Configuration
MONGO_URI=mongodb://localhost:27017/ai_fashion_otd

# JWT Security
JWT_ACCESS_SECRET=super_secret_access_jwt_key_otd_2026_fashion
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_otd_2026_fashion
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=*

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
