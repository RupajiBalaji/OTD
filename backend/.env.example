# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1

# Database Configuration
MONGO_URI=mongodb://localhost:27017/ai_fashion_otd

# JWT Security (Must be high-entropy 64+ char random keys in production)
JWT_ACCESS_SECRET=your_production_jwt_access_secret_entropy_64_chars_min
JWT_REFRESH_SECRET=your_production_jwt_refresh_secret_entropy_64_chars_min
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS Allowed Origins (Comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Optional Foundation Model AI Providers (Gemini / OpenAI)
# If omitted or unconfigured, OTD automatically utilizes its built-in deterministic algorithmic fashion engine.
AI_PROVIDER=algorithmic
GEMINI_API_KEY=
OPENAI_API_KEY=
